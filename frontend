#!/bin/sh
set -eu

cd "$(dirname "$0")"

case "${1:-}" in
    vue)
        exec docker compose -f compose.yaml -f compose.vue.yaml up -d --build --no-deps frontend
        ;;
    flutter)
        exec docker compose up -d --build --no-deps frontend
        ;;
    *)
        printf '%s\n' 'Use: ./frontend vue ou ./frontend flutter' >&2
        exit 1
        ;;
esac
